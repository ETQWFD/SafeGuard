/* SafeGuard 明亮主题 - {accent} 为主题色占位符 */

* {
    font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 13px;
    color: #1F2937;
}

QWidget {
    background: transparent;
}

#windowContainer {
    background: #F6F8FC;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
}

/* ------- 标题栏 ------- */
#titleBar {
    background: #FFFFFF;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom: 1px solid #EEF1F6;
}
#titleLogo { font-size: 18px; }
#titleText {
    font-size: 14px;
    font-weight: 600;
    color: {accent};
}
#titleBtnMin, #titleBtnClose {
    background: transparent;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    color: #6B7280;
}
#titleBtnClose:hover { background: #FEE2E2; color: #DC2626; }
#titleBtnMin:hover { background: #EEF1F6; }

/* ------- 侧边栏 ------- */
#sidebar {
    background: #FFFFFF;
    border-right: 1px solid #EEF1F6;
    border-bottom-left-radius: 16px;
    padding: 12px 8px;
    outline: none;
}
#sidebar::item {
    border-radius: 10px;
    padding-left: 14px;
    height: 44px;
    color: #4B5563;
}
#sidebar::item:hover { background: #F1F5FB; color: {accent}; }
#sidebar::item:selected {
    background: rgba({accent_rgb}, 0.14);
    color: {accent};
    font-weight: 600;
    border-left: 3px solid {accent};
}

/* ------- 页面标题 ------- */
#pageTitle { font-size: 20px; font-weight: 700; color: #111827; }

/* ------- 卡片 ------- */
#statusCard, #infoCard, #chartCard {
    background: #FFFFFF;
    border: 1px solid #EEF1F6;
    border-radius: 14px;
}
#statusIcon { font-size: 34px; }
#statusText { font-size: 17px; font-weight: 600; color: {accent}; }
#cardTitle { font-size: 14px; font-weight: 600; color: #111827; }
#cardBody { font-size: 12px; color: #6B7280; }

/* ------- 按钮 ------- */
QPushButton {
    border-radius: 10px;
    padding: 6px 16px;
    background: #EEF1F6;
    border: none;
    color: #374151;
    font-weight: 600;
}
QPushButton:hover { background: #E2E8F0; }
#primaryBtn { background: {accent}; color: #FFFFFF; }
#primaryBtn:hover { background: rgba({accent_rgb}, 0.85); }
#dangerBtn { background: #FEE2E2; color: #DC2626; }
#dangerBtn:hover { background: #FECACA; }
#ghostBtn { background: transparent; border: 1px solid #D1D5DB; color: #4B5563; }
#ghostBtn:hover { border-color: {accent}; color: {accent}; }

/* ------- 进度条 ------- */
QProgressBar {
    background: #EEF1F6;
    border: none;
    border-radius: 8px;
    height: 14px;
    text-align: center;
    font-size: 10px;
    color: #374151;
}
QProgressBar::chunk {
    background: {accent};
    border-radius: 8px;
}

/* ------- 表格 ------- */
#resultTable {
    background: #FFFFFF;
    border: 1px solid #EEF1F6;
    border-radius: 12px;
    gridline-color: #F1F5F9;
    selection-background-color: rgba({accent_rgb}, 0.15);
    selection-color: #111827;
}
QHeaderView::section {
    background: #F8FAFC;
    border: none;
    border-bottom: 1px solid #EEF1F6;
    padding: 8px;
    font-weight: 600;
    color: #374151;
}

/* ------- 事件列表 ------- */
#eventList {
    background: #FFFFFF;
    border: 1px solid #EEF1F6;
    border-radius: 12px;
    padding: 6px;
}
#eventList::item { padding: 6px 8px; border-radius: 8px; }
#eventList::item:selected { background: rgba({accent_rgb}, 0.12); }

/* ------- 输入与下拉 ------- */
QLineEdit, QComboBox {
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: {accent};
}
QLineEdit:focus, QComboBox:focus { border-color: {accent}; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    selection-background-color: rgba({accent_rgb}, 0.15);
    selection-color: #111827;
}

/* ------- 威胁弹窗 ------- */
#threatTitle { font-size: 16px; font-weight: 700; color: #DC2626; }
#threatInfo { background: #FFF7F7; border: 1px solid #FEE2E2; border-radius: 12px; }

/* ------- Toast ------- */
#toast {
    background: rgba(17, 24, 39, 0.88);
    color: #FFFFFF;
    border-radius: 10px;
    padding: 10px 18px;
    font-size: 13px;
}

QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 18px; height: 18px;
    border: 2px solid #CBD5E1;
    border-radius: 5px;
    background: #FFFFFF;
}
QCheckBox::indicator:checked { background: {accent}; border-color: {accent}; }

#aboutLogo { font-size: 26px; font-weight: 800; color: {accent}; }
